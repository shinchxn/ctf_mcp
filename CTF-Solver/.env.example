# Gemini API Key configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Kali Linux API Server URL (default: http://localhost:5000)
KALI_SERVER_URL=http://localhost:5000

# Optional: Request timeout in seconds (default: 300)
KALI_REQUEST_TIMEOUT=300

# Optional: Gemini model selection (default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.5-pro, etc.
GEMINI_MODEL=gemini-2.5-flash
